# ============================================
# Honicstore Admin Dashboard - Environment Variables
# ============================================
# This app shares the same Supabase database as the main honicstore app
# Copy values from the main app's .env.local

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://siem.honiccompanystore.com
NEXT_PUBLIC_SITE_URL=https://siem.honiccompanystore.com

# ============================================
# Supabase Configuration (SHARED with main app)
# ============================================
# Required: Supabase project URL and anon key (same as main app)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Required for admin operations (same as main app)
# SECURITY: Never expose this key to client-side code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Email Service Configuration
# ============================================
# Resend API (for transactional emails)
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=your_resend_api_key

# SMTP Configuration (alternative to Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false

# SMTP Sender Names
SMTP_SENDER_NAME_NOREPLY=Honic noreply
SMTP_SENDER_NAME_SUPPORT=Honic Store Support
SMTP_SENDER_NAME_INFO=Honic Store Info

# ============================================
# Email Addresses
# ============================================
CONTACT_EMAIL=contact@honiccompanystore.com
SUPPORT_EMAIL=support@honiccompanystore.com
SALES_EMAIL=sales@honiccompanystore.com
NOREPLY_EMAIL=noreply@mail.honiccompanystore.com

# SMTP Sender Email Configuration
SMTP_SENDER_EMAIL_NOREPLY=noreply@mail.honiccompanystore.com
SMTP_SENDER_EMAIL_SUPPORT=support@mail.honiccompanystore.com
SMTP_SENDER_EMAIL_INFO=info@mail.honiccompanystore.com

# ============================================
# Encryption Keys (for payout account encryption)
# ============================================
# SECURITY: Required for encrypting sensitive payout account data
# Same as main app to ensure compatibility
PAYOUT_ENCRYPTION_KEY=your_encryption_key
ENCRYPTION_KEY=your_encryption_key

# ============================================
# Cron Secret (for scheduled tasks)
# ============================================
CRON_SECRET=your_cron_secret

# ============================================
# Cache Configuration
# ============================================
CACHE_TTL_PRODUCTS=300000
CACHE_TTL_CATEGORIES=1800000
CACHE_TTL_ADVERTISEMENTS=600000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
